# Copy this file to `.env` and adjust. Every setting is optional.
# Lines starting with # are comments.

# --- Which hardware profile? -----------------------------------------------
# auto    = detect GPU + installed Ollama models and pick the best fit (default)
# cpu     = laptops / PCs without a GPU
# gpu     = one GPU with >= 32 GB free memory
# gpu-max = data-centre GPU with >= 72 GB free memory (e.g. H100 80GB)
RAG_PROFILE=auto

# --- Where is Ollama running? ------------------------------------------------
# Same machine:            http://localhost:11434
# A GPU server on network: http://<server-ip>:11434
RAG_OLLAMA_URL=http://localhost:11434

# --- Override individual models (leave commented to use the profile's) ------
# RAG_LLM_MODEL=qwen3:32b
# RAG_LLM_NUM_CTX=16384
# RAG_EMBED_PROVIDER=ollama          # fastembed (in-app) | ollama
# RAG_EMBED_MODEL=qwen3-embedding:0.6b
# RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3   # or "none" to disable
# RAG_TOP_K_RETRIEVE=40              # candidates from search
# RAG_TOP_K_CONTEXT=8                # passages given to the LLM
# RAG_MIN_RERANK_SCORE=              # drop weak passages below this score

# --- Ingestion -----------------------------------------------------------------
# RAG_CHUNK_SIZE_TOKENS=450
# RAG_CHUNK_OVERLAP_TOKENS=60

# --- Storage ---------------------------------------------------------------------
# RAG_DATA_DIR=data
# RAG_QDRANT_URL=http://localhost:6333   # use a Qdrant server instead of embedded files

# --- API server ------------------------------------------------------------------
# RAG_API_HOST=127.0.0.1             # 0.0.0.0 to allow other computers to connect
# RAG_API_PORT=8000
# RAG_API_KEY=change-me              # require header  X-API-Key: change-me

# --- Hardware ----------------------------------------------------------------------
# RAG_USE_CUDA=                      # run embeddings/reranker on GPU; empty = auto (on when
#                                     # onnxruntime-gpu is installed). Strongly recommended on the
#                                     # GPU server: the BGE reranker is ~15 s/question on CPU.
# RAG_OCR=auto                       # OCR scanned pages + tables saved as images; 'off' to disable
# RAG_OCR_DPI=300                    # OCR resolution (higher = more accurate, slower)
# RAG_ALLOW_CLOUD_MODELS=false        # Ollama ':cloud' models send passages to ollama.com
# RAG_THREADS=4
# RAG_LOG_LEVEL=INFO

# --- GUI (rag gui) -------------------------------------------------------------
# RAG_GUI_HOST=127.0.0.1              # 0.0.0.0 = other computers on the network can open it
# RAG_GUI_PORT=8501
# RAG_API_URL=http://gpu-server:8000  # GUI on one machine, API on another
